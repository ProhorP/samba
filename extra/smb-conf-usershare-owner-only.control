#!/bin/sh

. /etc/control.d/functions

CONFIG=/etc/samba/usershares.conf

new_subst disabled '^\s*usershare\s+owner\s+only\s*=\s*([Nn][Oo]|[Ff][Aa][Ll][Ss][Ee]|0)\s*' 's,^[[:space:]#;]*\(usershare\s\+owner\s\+only\s*\)=\(.*\)$,\t\1= no,'
new_subst enabled '^\s*usershare\s+owner\s+only\s*=\s*([Yy][Ee][Ss]|[Tt][Rr][Uu][Ee]|1)\s*' 's,^[[:space:]#;]*\(usershare\s\+owner\s\+only\s*\)=\(.*\)$,\t\1= yes,'
new_subst default '^\s*[#;][[:space:]#;]*usershare\s+owner\s+only\s*=' 's,^\(\s*usershare\s\+owner\s\+only\s*=.*\)$,#\1,'

new_summary "Determines samba restriction of only directories owned by the sharing user can be shared by usershares"
new_help disabled "Disable restriction of only directories owned by the sharing user can be shared by samba usershares"
new_help enabled "Enable restriction of only directories owned by the sharing user can be shared by samba usershares"
new_help default "Default (enable) restriction of only directories owned by the sharing user can be shared by samba usershares"

control_subst "$CONFIG" "$*"
